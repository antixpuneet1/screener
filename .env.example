# Copy to .env and adjust.

PORT=4000

# Data source: "mock" (default, no credentials needed) or "kite" (Zerodha Kite Connect).
# Implement a new class in src/providers/ + register it in src/providers/index.ts to
# plug in a different broker/vendor.
DATA_PROVIDER=mock

# --- Kite Connect settings (only used when DATA_PROVIDER=kite) ---
# Generate KITE_ACCESS_TOKEN daily via the Kite Connect login flow; it expires each day.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
KITE_BASE_URL=https://api.kite.trade

# How often the full F&O universe is re-scanned for O=L contracts (ms).
REFRESH_INTERVAL_MS=10000

# How often the instrument master (F&O universe) is refreshed from the provider (ms).
INSTRUMENT_REFRESH_MS=1800000

# NSE market hours, IST, 24h HH:MM.
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# Set true to scan outside market hours (demos/testing).
IGNORE_MARKET_HOURS=false

# Max retries for a rate-limited/failed provider request before giving up on that batch.
MAX_RETRIES=4
