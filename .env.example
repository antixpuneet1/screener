# Copy to .env and adjust.

PORT=4000

# Data source: "upstox" (default, live) or "mock" (simulated, no credentials needed).
# Implement a new class in src/providers/ + register it in src/providers/index.ts to
# plug in a different broker/vendor.
DATA_PROVIDER=upstox

# --- Upstox settings (only used when DATA_PROVIDER=upstox) ---
# Generate UPSTOX_ACCESS_TOKEN daily via the Upstox OAuth login flow; it expires
# every day around 3:30am IST. See README for the login-flow steps.
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
# Upstox's documented cap is 25 req/s, 250/min, 1000/30min - raise only if your app's
# assigned limits allow more than this conservative default.
UPSTOX_QUOTE_RATE_LIMIT_PER_SECOND=8

# How often the full F&O universe is re-scanned for O=L contracts (ms). Keep high enough
# that (contract count / 500 per batch) requests per cycle stays well under Upstox's
# per-minute rate limit - see README for sizing guidance.
REFRESH_INTERVAL_MS=20000

# How often the instrument master (F&O universe) is refreshed from the provider (ms).
INSTRUMENT_REFRESH_MS=1800000

# NSE market hours, IST, 24h HH:MM.
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# Set true to scan outside market hours (demos/testing).
IGNORE_MARKET_HOURS=false

# Max retries for a rate-limited/failed provider request before giving up on that batch.
MAX_RETRIES=4
